{
  "manifest_version": 3,
  "name": "RunningHub Canvas Bridge",
  "version": "0.10.9",
  "description": "Read and edit RunningHub infinite canvases through a local bridge.",
  "permissions": [
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.runninghub.ai/*",
    "https://rhtv.runninghub.ai/*",
    "https://www.runninghub.cn/*",
    "https://rhtv.runninghub.cn/*",
    "http://127.0.0.1:18765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.runninghub.ai/*",
        "https://rhtv.runninghub.ai/*",
        "https://www.runninghub.cn/*",
        "https://rhtv.runninghub.cn/*"
      ],
      "js": [
        "site-policy.js",
        "bridge-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.runninghub.ai/*",
        "https://rhtv.runninghub.ai/*",
        "https://www.runninghub.cn/*",
        "https://rhtv.runninghub.cn/*"
      ],
      "js": [
        "keepalive.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "version_name": "0.10.9 · afdog Codex image edition · SPA fix",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RunningHub Canvas Bridge · Codex",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
